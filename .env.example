# flightmode-api base URL. In development keep the default and let Vite proxy /api.
# Production (Vercel): .env.production keeps /api/v1; vercel.json rewrites /api to http://159.89.82.25/api.
VITE_API_URL=/api/v1

# Vite dev proxy target (flightmode-api: php artisan serve)
VITE_API_PROXY_TARGET=http://localhost:8000

# Agency portal host (res.skythium.com): agency users are sent there, other users back to the admin host.
# Leave empty until the domain is live — then everyone stays on the host they opened.
VITE_AGENCY_PORTAL_HOST=
VITE_ADMIN_HOST=
